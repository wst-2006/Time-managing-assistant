{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Time Managing Assistant",
  "version": "0.2.0",
  "identifier": "com.wst2006.timemanagingassistant",
  "build": {
    "beforeDevCommand": "corepack pnpm --dir ../.. dev:local",
    "beforeBuildCommand": "corepack pnpm --dir ../web build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "时间管理助手",
        "visible": false,
        "width": 1200,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "runtime/**/*"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer/installer-hooks.nsh"
      }
    }
  }
}
