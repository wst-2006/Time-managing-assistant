# Time Managing Assistant — optional settings.
# Nothing here is required: the app keeps its data in a local folder and runs without any account.
# Do not commit a filled-in copy of this file.

# Where your data lives. Leave empty to use ~/.time-managing-assistant/data
# (the Windows installer uses the app's own data folder instead).
TMA_DATA_DIR=

# ---------------------------------------------------------------------------
# Optional: Feishu (飞书) reminders and interactive cards.
# Leave these empty if you don't use Feishu; reminders then stay inside the app.
# WebSocket mode connects to Feishu directly and needs no public URL or tunnel.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TARGET_OPEN_ID=
# websocket | http
FEISHU_CALLBACK_TRANSPORT=websocket
FEISHU_WS_HANDSHAKE_TIMEOUT_MS=15000
FEISHU_WS_RETRY_BASE_MS=5000
FEISHU_WS_RETRY_MAX_MS=60000
# Used only when FEISHU_CALLBACK_TRANSPORT=http.
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
# Optional link for the card's "open task" button.
APP_PUBLIC_URL=
